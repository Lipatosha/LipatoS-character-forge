<div class="spell-rules-config">
    <header class="spell-rules-header">
        <h2><i class="fas fa-hat-wizard"></i> {{localize "ORIGINATE.Settings.SpellRules.TabTitle"}}</h2>
        <p class="config-hint">{{localize "ORIGINATE.Settings.SpellRules.Hint"}}</p>
    </header>

    <div class="spell-rules-toolbar">
        <button type="button" class="btn-add-class" data-action="addSpellRule">
            <i class="fas fa-plus"></i> {{localize "ORIGINATE.Settings.SpellRules.AddClass"}}
        </button>
    </div>

    <div class="spell-rules-body">
        {{#each classes}}
        <div class="spell-rule-card {{#if isCustom}}is-custom{{/if}} {{#if isExpanded}}expanded{{/if}}"
            data-class-id="{{id}}">
            {{!-- 职业头部行 --}}
            <div class="spell-rule-card-header" data-action="toggleClassExpand" data-class="{{id}}">
                <i class="fas fa-chevron-right expand-icon"></i>
                <span class="class-name">{{label}}</span>
                <div class="class-badges">
                    <span class="badge badge-type">{{typeLabel}}</span>
                    <span class="badge badge-progression">{{progressionLabel}}</span>
                    {{#if isCustom}}<span class="badge badge-custom">{{localize
                        "ORIGINATE.Settings.SpellRules.Custom"}}</span>{{/if}}
                </div>
                <div class="class-quick-info">
                    <span class="qi-item" title="{{localize 'ORIGINATE.Settings.SpellRules.SpellList'}}"><i
                            class="fas fa-book-open"></i> {{listStr}}</span>
                    <span class="qi-item" title="{{localize 'ORIGINATE.Settings.SpellRules.ReplacePer'}}"><i
                            class="fas fa-exchange-alt"></i> {{replacementsPerLevel}}</span>
                </div>
            </div>

            {{!-- 展开的编辑区域 --}}
            <div class="spell-rule-expand-body">
                {{!-- 属性编辑行 --}}
                <div class="spell-rule-props">
                    <div class="prop-field">
                        <label>{{localize "ORIGINATE.Settings.SpellRules.Type"}}</label>
                        <select class="sr-input" data-field="type" data-class="{{id}}">
                            <option value="known" {{#if (eq type 'known' )}}selected{{/if}}>{{localize
                                "ORIGINATE.Settings.SpellRules.TypeKnown"}}</option>
                            <option value="prepared" {{#if (eq type 'prepared' )}}selected{{/if}}>{{localize
                                "ORIGINATE.Settings.SpellRules.TypePrepared"}}</option>
                            <option value="pact" {{#if (eq type 'pact' )}}selected{{/if}}>{{localize
                                "ORIGINATE.Settings.SpellRules.TypePact"}}</option>
                        </select>
                    </div>
                    <div class="prop-field">
                        <label>{{localize "ORIGINATE.Settings.SpellRules.Progression"}}</label>
                        <select class="sr-input" data-field="progression" data-class="{{id}}">
                            <option value="full" {{#if (eq progression 'full' )}}selected{{/if}}>Full</option>
                            <option value="half" {{#if (eq progression 'half' )}}selected{{/if}}>Half</option>
                            <option value="third" {{#if (eq progression 'third' )}}selected{{/if}}>Third</option>
                            <option value="pact" {{#if (eq progression 'pact' )}}selected{{/if}}>Pact</option>
                        </select>
                    </div>
                    <div class="prop-field">
                        <label>{{localize "ORIGINATE.Settings.SpellRules.SpellList"}}</label>
                        <input type="text" class="sr-input" data-field="list" data-class="{{id}}" value="{{listStr}}">
                    </div>
                    <div class="prop-field prop-narrow">
                        <label>{{localize "ORIGINATE.Settings.SpellRules.ReplacePer"}}</label>
                        <input type="number" class="sr-input" data-field="replacementsPerLevel" data-class="{{id}}"
                            value="{{replacementsPerLevel}}" min="0" max="5">
                    </div>
                    {{#if showPreparedFormula}}
                    <div class="prop-field">
                        <label>{{localize "ORIGINATE.Settings.SpellRules.PreparedFormula"}}</label>
                        <input type="text" class="sr-input" data-field="preparedFormula" data-class="{{id}}"
                            value="{{preparedFormula}}" placeholder="level + wis">
                    </div>
                    {{/if}}
                </div>

                {{!-- 法术/戏法数量表格 --}}
                <div class="spell-rule-table-wrap">
                    <table class="sr-table">
                        <thead>
                            <tr>
                                <th class="sr-th-label"></th>
                                {{#each ../levelColumns}}
                                <th class="sr-th-level">{{this}}</th>
                                {{/each}}
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="sr-td-label">{{localize "ORIGINATE.Settings.SpellRules.Cantrips"}}</td>
                                {{#each cantripsRow}}
                                <td><input type="number" class="sr-cell" data-class="{{../id}}" data-row="cantrips"
                                        data-level="{{this.level}}" value="{{this.value}}" min="0" max="20"></td>
                                {{/each}}
                            </tr>
                            {{#if hasKnownSpellsRow}}
                            <tr>
                                <td class="sr-td-label">{{localize "ORIGINATE.Settings.SpellRules.SpellsKnown"}}</td>
                                {{#each knownSpellsRow}}
                                <td><input type="number" class="sr-cell" data-class="{{../id}}" data-row="spellsKnown"
                                        data-level="{{this.level}}" value="{{this.value}}" min="0" max="50"></td>
                                {{/each}}
                            </tr>
                            {{/if}}
                            {{#if hasPreparedSpellsRow}}
                            <tr>
                                <td class="sr-td-label">{{localize "ORIGINATE.Settings.SpellRules.PreparedSpells"}}</td>
                                {{#each preparedSpellsRow}}
                                <td><input type="number" class="sr-cell" data-class="{{../id}}" data-row="preparedSpells"
                                        data-level="{{this.level}}" value="{{this.value}}" min="0" max="50"></td>
                                {{/each}}
                            </tr>
                            {{/if}}
                        </tbody>
                    </table>
                </div>

                {{!-- 操作按钮 --}}
                <div class="spell-rule-btns">
                    <button type="button" class="sr-btn sr-btn-save" data-action="saveSpellRule" data-class="{{id}}">
                        <i class="fas fa-save"></i> {{localize "ORIGINATE.Settings.SpellRules.Save"}}
                    </button>
                    <button type="button" class="sr-btn sr-btn-reset" data-action="resetSpellRule" data-class="{{id}}">
                        <i class="fas fa-undo"></i> {{localize "ORIGINATE.Settings.SpellRules.Reset"}}
                    </button>
                    {{#if isCustom}}
                    <button type="button" class="sr-btn sr-btn-delete" data-action="deleteSpellRule"
                        data-class="{{id}}">
                        <i class="fas fa-trash"></i> {{localize "ORIGINATE.Settings.SpellRules.Delete"}}
                    </button>
                    {{/if}}
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>
