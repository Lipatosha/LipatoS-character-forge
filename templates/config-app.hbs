<div class="originate-config-container">
    <!-- 
        标签页
        Adrian: 这里的分类逻辑简直是个谜。
        为什么单数变复数这么麻烦？英语真是门奇怪的语言。
    -->
    <nav class="sheet-tabs tabs" aria-role="tablist">
        {{#each tabs}}
        <a class="item {{#if this.active}}active{{/if}}" data-action="changeTab" data-tab="{{this.id}}">
            {{this.label}}
        </a>
        {{/each}}
    </nav>

    <!-- 
        内容区域
        Adrian: 欢迎来到控制台。这里有很多按钮和开关。
        有些是给你用的，有些是我调试用的。别乱按那些标着'危险'的按钮。
    -->
    <div class="config-content">
        <div class="config-drop-zone">
            <i class="fas fa-download"></i>
            <p>{{localize "ORIGINATE.UI.Config.DragDrop" type=currentTab}}</p>
            <small>{{localize "ORIGINATE.UI.Config.AutoParse"}}</small>
        </div>

        <div class="config-list">
            {{#each data as |entry key|}}
            <div class="config-item" data-key="{{key}}">
                <div class="config-item-header">
                    <img src="{{entry.img}}" width="40" height="40">
                    <div class="config-item-info">
                        <span class="config-item-name">{{entry.name}}</span>
                        <span class="config-item-id">{{entry.identifier}}</span>
                    </div>
                    <div class="config-item-controls">
                        <a data-action="deleteEntry" data-key="{{key}}" title="{{localize 'ORIGINATE.Settings.Config.Remove'}}"><i class="fas fa-trash"></i></a>
                    </div>
                </div>

                {{!-- 封面图设置 --}}
                <div class="config-item-cover-image">
                    <label>{{localize "ORIGINATE.UI.Config.CoverImage"}}</label>
                    <div class="cover-image-preview">
                        {{#if entry.coverImage}}
                        <img src="{{entry.coverImage}}" class="cover-preview-img" alt="{{localize 'ORIGINATE.UI.Config.CoverPreview'}}">
                        {{else}}
                        <div class="cover-placeholder">
                            <i class="fas fa-image"></i>
                            <span>{{localize "ORIGINATE.UI.Config.CoverImage.Unset"}}</span>
                        </div>
                        {{/if}}
                    </div>
                    <div class="cover-image-controls">
                        <button type="button" class="cover-image-btn" data-key="{{key}}">
                            <i class="fas fa-folder-open"></i> {{localize "ORIGINATE.UI.Config.CoverImage.Select"}}
                        </button>
                        {{#if entry.coverImage}}
                        <button type="button" class="clear-cover-btn" data-key="{{key}}">
                            <i class="fas fa-times"></i> {{localize "ORIGINATE.UI.Config.CoverImage.Clear"}}
                        </button>
                        {{/if}}
                    </div>
                    <small>{{localize "ORIGINATE.UI.Config.CoverImage.Hint"}}</small>
                </div>

                {{#if ../isSubclass}}
                <div class="config-item-subclass-binding">
                    <label>{{localize "ORIGINATE.UI.Config.Subclass.Binding"}}</label>
                    {{#if entry.classIdentifier}}
                    <div class="subclass-class-display">
                        <input type="text" value="{{entry.classIdentifier}}" disabled class="class-identifier-input">
                        <small class="subclass-class-info">{{localize "ORIGINATE.UI.Config.Subclass.AutoInfo"}}</small>
                    </div>
                    {{else}}
                    <select class="subclass-class-select" data-key="{{key}}">
                        <option value="">{{localize "ORIGINATE.UI.Config.Subclass.Select"}}</option>
                        {{#each ../availableClasses as |cls clsKey|}}
                        <option value="{{cls.identifier}}" {{#if (eq cls.identifier ../entry.classIdentifier)}}selected{{/if}}>{{cls.name}}</option>
                        {{/each}}
                    </select>
                    <small class="subclass-class-warning">{{localize "ORIGINATE.UI.Config.Subclass.Warning"}}</small>
                    {{/if}}
                </div>
                {{/if}}

                {{!-- 职业专用：生命骰配置 --}}
                {{#if (eq ../currentTab "class")}}
                <div class="config-item-hitdie">
                    <label>{{localize "ORIGINATE.UI.Config.HitDie"}}</label>
                    <select class="hitdie-select" data-key="{{key}}">
                        <option value="6" {{#if (eq entry.hitDie 6)}}selected{{/if}}>d6</option>
                        <option value="8" {{#if (eq entry.hitDie 8)}}selected{{/if}}>d8</option>
                        <option value="10" {{#if (eq entry.hitDie 10)}}selected{{/if}}>d10</option>
                        <option value="12" {{#if (eq entry.hitDie 12)}}selected{{/if}}>d12</option>
                    </select>
                    <small>{{localize "ORIGINATE.UI.Config.HitDie.Hint"}}</small>
                </div>
                {{/if}}

                {{!-- 背景专用：ASI 锁定属性配置 --}}
                {{#if (eq ../currentTab "background")}}
                <div class="config-item-asi-locked asi-locked-config" data-key="{{key}}">
                    <label>{{localize "ORIGINATE.UI.Config.ASI.Locked"}}</label>
                    <p class="config-hint">{{localize "ORIGINATE.UI.Config.ASI.Hint"}}</p>
                    <div class="asi-locked-checkboxes">
                        <label class="asi-checkbox">
                            <input type="checkbox" value="str" {{#if (includes entry.asiLocked "str")}}checked{{/if}}>
                            <span>{{localize 'ORIGINATE.Ability.Str'}} (STR)</span>
                        </label>
                        <label class="asi-lock-checkbox">
                            <input type="checkbox" value="dex" {{#if (includes entry.asiLocked "dex")}}checked{{/if}}>
                            <span>{{localize 'ORIGINATE.Ability.Dex'}} (DEX)</span>
                        </label>
                        <label class="asi-lock-checkbox">
                            <input type="checkbox" value="con" {{#if (includes entry.asiLocked "con")}}checked{{/if}}>
                            <span>{{localize 'ORIGINATE.Ability.Con'}} (CON)</span>
                        </label>
                        <label class="asi-lock-checkbox">
                            <input type="checkbox" value="int" {{#if (includes entry.asiLocked "int")}}checked{{/if}}>
                            <span>{{localize 'ORIGINATE.Ability.Int'}} (INT)</span>
                        </label>
                        <label class="asi-lock-checkbox">
                            <input type="checkbox" value="wis" {{#if (includes entry.asiLocked "wis")}}checked{{/if}}>
                            <span>{{localize 'ORIGINATE.Ability.Wis'}} (WIS)</span>
                        </label>
                        <label class="asi-lock-checkbox">
                            <input type="checkbox" value="cha" {{#if (includes entry.asiLocked "cha")}}checked{{/if}}>
                            <span>{{localize 'ORIGINATE.Ability.Cha'}} (CHA)</span>
                        </label>
                    </div>
                </div>
                {{/if}}

                <div class="config-item-advancement">
                    {{#if entry.advancement.length}}
                    {{#each entry.advancement as |levelGroup|}}
                    <div class="advancement-level-group">
                        <div class="level-header">
                            <span class="level-badge">{{#if levelGroup.level}}{{localize 'ORIGINATE.UI.ConfigContent.Level.Lv' level=levelGroup.level}}{{else}}{{localize 'ORIGINATE.UI.ConfigContent.Level.Initial'}}{{/if}}</span>
                        </div>
                        <div class="advancement-entries">
                            {{#each levelGroup.entries as |adv|}}
                            <div class="advancement-entry adv-type-{{adv.type}}">
                                <i class="fas {{adv.icon}}"></i>
                                <span class="adv-title">{{adv.title}}</span>
                                <span class="adv-type-label">[{{adv.type}}]</span>
                                
                                {{#if adv.details}}
                                <div class="adv-details">{{adv.details}}</div>
                                {{/if}}
                                
                                {{#if adv.choiceInfo}}
                                <div class="adv-details">{{adv.choiceInfo}} ({{localize "ORIGINATE.UI.Config.Advancement.Pool"}}: {{adv.poolCount}})</div>
                                {{/if}}
                                
                                {{#if adv.items.length}}
                                <div class="adv-items">
                                    {{#each adv.items as |item|}}
                                    <div class="adv-item {{#if item.optional}}optional{{/if}}">
                                        <img src="{{item.img}}" width="20" height="20">
                                        <span>{{item.name}}</span>
                                        {{#if item.optional}}<span class="optional-tag">{{localize "ORIGINATE.UI.Config.Advancement.Optional"}}</span>{{/if}}
                                    </div>
                                    {{/each}}
                                </div>
                                {{/if}}
                                
                                {{#if adv.pool.length}}
                                <details class="adv-pool-details">
                                    <summary>{{localize "ORIGINATE.UI.Config.Advancement.ViewPool"}} ({{adv.pool.length}})</summary>
                                    <div class="adv-items">
                                        {{#each adv.pool as |item|}}
                                        <div class="adv-item">
                                            <img src="{{item.img}}" width="20" height="20">
                                            <span>{{item.name}}</span>
                                        </div>
                                        {{/each}}
                                    </div>
                                </details>
                                {{/if}}
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/each}}
                    {{else}}
                    <p class="no-advancement">{{localize "ORIGINATE.UI.Config.Advancement.None"}}</p>
                    {{/if}}
                </div>
            </div>
            {{else}}
            <p class="empty-state">
                <i class="fas fa-info-circle"></i>
                {{localize "ORIGINATE.UI.Config.Empty"}}
            </p>
            {{/each}}
        </div>

        <footer class="sheet-footer">
            <button type="button" data-action="save">
                <i class="fas fa-save"></i> {{localize "ORIGINATE.UI.Config.Save"}}
            </button>
        </footer>
    </div>
</div>
