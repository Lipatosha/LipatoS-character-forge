<!-- 
    右侧边栏
    Adrian: 角色概览。
    在这里你可以看到你捏出来的"缝合怪"目前长什么样。
    别担心，只要你不乱选，它应该能跑起来。
-->
<div class="originate-sidebar-right">
    <h3>{{localize "ORIGINATE.UI.Sidebar.Summary.Title"}}</h3>

    <div class="summary-section">
        <h4>{{localize "ORIGINATE.UI.Sidebar.Summary.Race"}}</h4>
        <p>{{localize summary.raceName}}</p>
    </div>

    <div class="summary-section">
        <h4>{{localize "ORIGINATE.UI.Sidebar.Summary.Class"}}</h4>
        <p>{{localize summary.className}}</p>
    </div>

    <div class="summary-section">
        <h4>{{localize "ORIGINATE.UI.Sidebar.Summary.Background"}}</h4>
        <p>{{localize summary.backgroundName}}</p>
    </div>

    <div class="summary-section">
        <h4>{{localize "ORIGINATE.UI.Sidebar.Summary.Abilities"}}</h4>
        <div class="ability-preview-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
            {{#each context.abilities}}
            <div class="ability-preview-item">
                <span style="text-transform: uppercase; font-weight: bold;">{{@key}}:</span> {{this}}
            </div>
            {{/each}}
        </div>
    </div>
</div>
