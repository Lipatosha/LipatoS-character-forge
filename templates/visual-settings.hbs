<!-- 
    视觉设置界面
    Adrian: 装修队的控制面板。
    为了让界面看起来不那么像上世纪的 Excel 表格，我头发都掉了好几根。
    毕竟颜值就是正义，也是销量嘛。
-->
<form class="originate-visual-settings">
    <div class="form-group">
        <label>{{localize "ORIGINATE.UI.Visual.Welcome"}}</label>
        <div class="form-fields">
            <input type="text" name="welcomeMessage" value="{{welcomeMessage}}" placeholder="{{localize "ORIGINATE.UI.Visual.Welcome.Placeholder"}}">
        </div>
        <p class="notes">{{localize "ORIGINATE.UI.Visual.Welcome.Hint"}}</p>
    </div>

    <div class="form-group">
        <label>{{localize "ORIGINATE.UI.Visual.Theme"}}</label>
        <div class="form-fields">
            <select name="themeColor">
                <option value="gold" {{#if (eq themeColor "gold")}}selected{{/if}}>{{localize "ORIGINATE.UI.Visual.Theme.Gold"}}</option>
                <option value="silver" {{#if (eq themeColor "silver")}}selected{{/if}}>{{localize "ORIGINATE.UI.Visual.Theme.Silver"}}</option>
                <option value="crimson" {{#if (eq themeColor "crimson")}}selected{{/if}}>{{localize "ORIGINATE.UI.Visual.Theme.Crimson"}}</option>
                <option value="emerald" {{#if (eq themeColor "emerald")}}selected{{/if}}>{{localize "ORIGINATE.UI.Visual.Theme.Emerald"}}</option>
                <option value="azure" {{#if (eq themeColor "azure")}}selected{{/if}}>{{localize "ORIGINATE.UI.Visual.Theme.Azure"}}</option>
            </select>
        </div>
        <p class="notes">{{localize "ORIGINATE.UI.Visual.Theme.Hint"}}</p>
    </div>

    <div class="form-group">
        <label>{{localize "ORIGINATE.UI.Visual.Animation"}}</label>
        <div class="form-fields">
            <label class="checkbox">
                <input type="checkbox" name="enableAnimations" {{#if enableAnimations}}checked{{/if}}>
                {{localize "ORIGINATE.UI.Visual.Animation.Enable"}}
            </label>
        </div>
        <p class="notes">{{localize "ORIGINATE.UI.Visual.Animation.Hint"}}</p>
    </div>

    <div class="form-group">
        <label>{{localize "ORIGINATE.UI.Visual.Panel"}}</label>
        <div class="form-fields">
            <select name="detailPanelDefault">
                <option value="collapsed" {{#if (eq detailPanelDefault "collapsed")}}selected{{/if}}>{{localize "ORIGINATE.UI.Visual.Panel.Collapsed"}}</option>
                <option value="expanded" {{#if (eq detailPanelDefault "expanded")}}selected{{/if}}>{{localize "ORIGINATE.UI.Visual.Panel.Expanded"}}</option>
            </select>
        </div>
        <p class="notes">{{localize "ORIGINATE.UI.Visual.Panel.Hint"}}</p>
    </div>
    
    <footer class="sheet-footer flexrow">
        <button type="submit" name="submit">
            <i class="far fa-save"></i> {{localize "ORIGINATE.UI.Config.Save"}}
        </button>
    </footer>
</form>
