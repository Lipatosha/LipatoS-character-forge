<!-- 
    左侧边栏
    Adrian: 这里是处理那些繁琐细节的地方。
    选技能、选专长、选装备……虽然不如主界面那么炫酷，
    但为了不让你们在填表时睡着，我还是尽量把它做得好看了一点。
-->
<div class="originate-sidebar-left">
    {{#if (eq currentStep "abilities")}}
        <div class="originate-info-panel">
            <h3>{{localize "ORIGINATE.UI.Sidebar.PointBuy.Title"}}</h3>
            <p>{{localize "ORIGINATE.UI.Sidebar.PointBuy.Desc"}}</p>
            <ul>
                <li>{{localize "ORIGINATE.UI.Sidebar.PointBuy.Rule1"}}</li>
                <li>{{localize "ORIGINATE.UI.Sidebar.PointBuy.Rule2"}}</li>
                <li>{{localize "ORIGINATE.UI.Sidebar.PointBuy.Rule3"}}</li>
            </ul>
            <div class="point-buy-summary">
                <div>{{localize "ORIGINATE.UI.Sidebar.PointBuy.Remaining"}}</div>
                <div class="points-remaining">{{pointsRemaining}}</div>
            </div>
        </div>
    {{else}}
        <h3>{{localize "ORIGINATE.UI.Sidebar.Select"}}{{activeStepLabel}}</h3>
        <div class="originate-options-list">
            {{#each options}}
            <div class="originate-option-card {{#if (eq ../context.[../currentStep] this.id)}}selected{{/if}}" 
                 data-action="selectOption" 
                 data-id="{{this.id}}">
                <div class="option-header">
                    <span class="option-name">{{this.name}}</span>
                    {{#if this.icon}}<img src="{{this.icon}}" class="option-icon">{{/if}}
                </div>
            </div>
            {{/each}}
        </div>
    {{/if}}
</div>
